{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ab recall --hook",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "ab capture --hook --host codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ab capture --hook --host codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ab capture --hook --host codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
